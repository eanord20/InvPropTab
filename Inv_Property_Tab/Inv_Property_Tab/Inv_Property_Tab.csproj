<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Inv_Property_Tab</AssemblyName>
    <RootNamespace>Inv_Property_Tab</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <ComVisible>false</ComVisible>
    <RegisterForComInterop>false</RegisterForComInterop>
    <UnregisterForComInterop>false</UnregisterForComInterop>
    <PlatformTarget>x64</PlatformTarget>
    <Inventor2020PublicAssemblies Condition="'$(Inventor2020PublicAssemblies)' == ''">$(ProgramFiles)\Autodesk\Inventor 2020\Bin\Public Assemblies</Inventor2020PublicAssemblies>
    <InventorAddinDeployDir2020 Condition="'$(InventorAddinDeployDir2020)' == ''">$(APPDATA)\Autodesk\Inventor 2020\Addins</InventorAddinDeployDir2020>
  </PropertyGroup>

  <ItemGroup>
    <None Include="InvPropTab.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(Inventor2020PublicAssemblies)\Autodesk.Inventor.Interop.dll</HintPath>
      <Private>True</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\default-fields.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Export\**\*.cs" />
    <Compile Remove="UI\Models\**\*.cs" />
    <Compile Remove="UI\ViewModels\**\*.cs" />
    <Compile Remove="UI\Views\**\*.cs" />
    <Compile Remove="MyButton.cs" />
  </ItemGroup>

  <Target Name="DeployInventor2020Addin" DependsOnTargets="Build">
    <MakeDir Directories="$(InventorAddinDeployDir2020)" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName);$(TargetDir)InvPropTab.addin" DestinationFolder="$(InventorAddinDeployDir2020)" />
  </Target>

  <Target Name="UnregisterAssembly" Condition="'$(MSBuildRuntimeType)' != 'Full'" />
  <Target Name="RegisterAssembly" Condition="'$(MSBuildRuntimeType)' != 'Full'" />

</Project>
