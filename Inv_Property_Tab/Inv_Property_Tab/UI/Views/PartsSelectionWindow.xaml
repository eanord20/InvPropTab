<Window x:Class="Inv_Property_Tab.UI.Views.PartsSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXF Export" Height="520" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Output folder:" VerticalAlignment="Center"/>
                <TextBox Width="600" Margin="8,0,8,0" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Browse..." Width="90" Click="Browse_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox Content="File name" IsChecked="{Binding IncludeFileName}" Margin="0,0,16,0"/>
                <CheckBox Content="Dimensions" IsChecked="{Binding IncludeDimensions}"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1"
                 x:Name="PartsGrid"
                  ItemsSource="{Binding Parts}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Extended">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <EventSetter Event="ContextMenuOpening" Handler="ColumnHeader_ContextMenuOpening" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Export" Binding="{Binding IsSelected}" Width="70"/>
                <DataGridTemplateColumn Header="Preview" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="#33000000" Padding="2" Width="64" Height="64">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="250"/>
                <DataGridTemplateColumn Header="Plane" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding OrientationOptions}"
                                      SelectedItem="{Binding Orientation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="70" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Export DXF" Width="120" Margin="0,0,8,0" Click="Export_Click"/>
            <Button Content="Close" Width="120" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
